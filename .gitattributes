# Store and check out text with LF endings on every OS.
# Windows CRLF breaks shell scripts and SQL init files inside Linux containers.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.pbf binary
*.zip binary
*.parquet binary
# Windows batch files need Windows line endings to run reliably.
*.bat text eol=crlf
# Shell scripts run inside Linux containers.
*.sh text eol=lf
# The seed database dump is binary.
*.dump binary
