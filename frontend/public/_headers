# Cloudflare Pages: built files carry a hash in their name, so browsers may keep
# them for good. Pages themselves keep Cloudflare's default (revalidate on every
# visit), so a new deployment shows up on the next load. (nginx, used by the
# Docker image, ignores this file and sets the same headers in nginx.conf.)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
