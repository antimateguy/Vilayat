# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.
# Every value below is a local-development default, so the stack also starts without a .env.

# --- Database container (read by docker-compose.yml) ---
POSTGRES_USER=educommute
POSTGRES_PASSWORD=educommute_dev
POSTGRES_DB=educommute
POSTGRES_PORT=5432

# --- Backend ---
# Used when the backend or tests run on your machine (outside Docker).
# Inside Compose the backend gets its own URL pointing at the "db" service.
DATABASE_URL=postgresql+psycopg://educommute:educommute_dev@localhost:5432/educommute
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Requests one client address may make per minute; 0 switches the limit off.
RATE_LIMIT_PER_MINUTE=120

# --- Frontend (copy this line into frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- AI layer ---
# Key from Google AI Studio (https://aistudio.google.com/apikey). Leave it empty
# to switch the AI features off; everything else works without it.
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Requests one client address may make per minute to the AI endpoints.
# AI_RATE_LIMIT_PER_MINUTE=10
# Requests per day each model may make: the free tier's allowance, a hard limit.
# When a count reaches it, that model's features stay off until midnight Pacific
# time. Check the current figures in Google AI Studio (Usage and limits).
# AI_DAILY_TEXT_REQUESTS=500
# AI_DAILY_EMBEDDING_REQUESTS=1000
# Lowest similarity at which a document passage counts as evidence for a
# question. Belongs to the embedding model; measured with backend/evaluation/.
# RAG_MIN_SIMILARITY=0.68

# --- Frontend (read when the frontend image is built) ---
# An address to show on the Contact page. Left empty, the page shows none.
# NEXT_PUBLIC_CONTACT_EMAIL=

# --- Deployment (read by the commands in docs/deployment.md, not by the app) ---
# The hosted database's address from Neon. Paste it here yourself; never commit
# this file or share the address.
# PRODUCTION_DATABASE_URL=
